# Copy to .env locally or configure these as Vercel Environment Variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Root website Vercel function: server-side CV extraction proxy (never expose the shared secret in JS)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CV_EXTRACTION_URL=
CV_EXTRACTION_SECRET=

# Optional: Google Places API (New), required to fetch live reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
